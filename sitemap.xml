---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
    {% for post in site.posts %}
    {% assign counterpart = site.posts_en | where: "alt_url", post.url | first %}
    <url>
        <loc>{{ post.url | prepend: site.baseurl | prepend: site.url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>weekly</changefreq>
        <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ post.url | prepend: site.baseurl | prepend: site.url }}"/>
        <xhtml:link rel="alternate" hreflang="en" href="{% if counterpart %}{{ counterpart.url | prepend: site.baseurl | prepend: site.url }}{% else %}{{ '/en/' | prepend: site.baseurl | prepend: site.url }}{% endif %}"/>
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ post.url | prepend: site.baseurl | prepend: site.url }}"/>
    </url>
    {% endfor %}
    {% for post in site.posts_en %}
    <url>
        <loc>{{ post.url | prepend: site.baseurl | prepend: site.url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>weekly</changefreq>
        <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ post.alt_url | prepend: site.baseurl | prepend: site.url }}"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ post.url | prepend: site.baseurl | prepend: site.url }}"/>
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ post.alt_url | prepend: site.baseurl | prepend: site.url }}"/>
    </url>
    {% endfor %}
    {% for post in site.pages %}{% if post.isNavItem and post.lang == 'en' %}
    <url>
        <loc>{{ post.url | prepend: site.baseurl | prepend: site.url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>weekly</changefreq>
        <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ post.alt_url | prepend: site.baseurl | prepend: site.url }}"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ post.url | prepend: site.baseurl | prepend: site.url }}"/>
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ post.alt_url | prepend: site.baseurl | prepend: site.url }}"/>
    </url>
    {% endif %}
    {% endfor %}
    {% for post in site.pages %}{% if post.isNavItem and post.lang != 'en' %}
    <url>
        <loc>{{ post.url | prepend: site.baseurl | prepend: site.url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>weekly</changefreq>
        <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ post.url | prepend: site.baseurl | prepend: site.url }}"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ post.en_url | prepend: site.baseurl | prepend: site.url }}"/>
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ post.url | prepend: site.baseurl | prepend: site.url }}"/>
    </url>
    {% endif %}
    {% endfor %}
</urlset>
